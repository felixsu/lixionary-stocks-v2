# Copy to .env and fill in. .env is git-ignored and must never be committed.
MONGO_USER=lixionary
MONGO_PASSWORD=change-me
MONGO_DB=lixionary_stock_v2

LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# Worker LLM for automated news analysis (optional — empty disables analysis,
# news is still fetched). Same providers as the in-app settings.
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
