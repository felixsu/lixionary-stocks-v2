# Copy to .env and fill in. .env is git-ignored and must never be committed.
MONGO_USER=lixionary
MONGO_PASSWORD=change-me
MONGO_DB=lixionary_stock_v2

LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# Worker LLM for automated news analysis (optional — empty disables analysis,
# news is still fetched). Same providers as the in-app settings.
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=

# --- Authentication (Google OAuth via Auth.js) ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=change-me
# OAuth client from https://console.cloud.google.com/apis/credentials
# (type "Web application"). Add every origin you use as an authorized
# redirect URI, e.g.:
#   http://localhost:3000/api/auth/callback/google   (dev)
#   http://localhost:8853/api/auth/callback/google   (docker)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Comma-separated Google account emails allowed to sign in.
# Empty = ANY Google account can sign in — set this in production.
AUTH_ALLOWED_EMAILS=
