# Nginx Configuration Template for Stock v2
# Place this config in /etc/nginx/sites-available/stockv2.lixionary.com.conf
# Enable it with: ln -s /etc/nginx/sites-available/stockv2.lixionary.com.conf /etc/nginx/sites-enabled/

server {
    server_name stockv2.lixionary.com;

    location / {
        proxy_pass http://127.0.0.1:8850; # Maps to Next.js frontend container port on host
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        
        # NextAuth/Auth.js proxy requirements
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;

        # WebSocket support (for Next.js dev server/HMR if needed)
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }

    # Certbot SSL Configuration will be added below automatically by running:
    # sudo certbot --nginx -d stockv2.lixionary.com
    listen 80;
}
